rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    match /dental_triage_queue/{id} {
      allow read: if true;
      allow write: if isValidId(id);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
